{
  "name": "nodejs-practices",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./dist/bin/www.js",
    "build": "tsc",
    "dev": "concurrently \"npm:watch:css\" \"nodemon --exec ts-node bin/www.ts\"",
    "debug": "DEBUG=nodejs-practices:*,express:* ts-node --inspect bin/www.ts",
    "debug:dev": "concurrently \"npm:watch:css\" \"DEBUG=nodejs-practices:*,express:* nodemon --exec ts-node --inspect bin/www.ts\"",
    "build:css": "npx tailwindcss -i ./src/tailwind.css -o ./public/stylesheets/style.css --minify",
    "watch:css": "npx tailwindcss -i ./src/tailwind.css -o ./public/stylesheets/style.css --watch",
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^17.4.1",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "~1.9.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pug": "2.0.0-beta11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/debug": "^4.1.0",
    "@types/express": "^4.17.0",
    "@types/http-errors": "^2.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.0.0",
    "@types/passport": "^1.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.8",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}

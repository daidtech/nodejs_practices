{
  "name": "nodejs-practices",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "c": "node -r ./scripts/console.js",
    "cma": "node -r ./scripts/console-prisma.js",
    "dev": "concurrently \"npm:watch:css\" \"nodemon ./bin/www\"",
    "debug": "DEBUG=nodejs-practices:*,express:* node --inspect ./bin/www",
    "debug:dev": "concurrently \"npm:watch:css\" \"DEBUG=nodejs-practices:*,express:* nodemon --inspect ./bin/www\"",
    "build:css": "npx tailwindcss -i ./src/tailwind.css -o ./public/stylesheets/style.css --minify",
    "watch:css": "npx tailwindcss -i ./src/tailwind.css -o ./public/stylesheets/style.css --watch"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^17.4.1",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.0",
    "morgan": "~1.9.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pug": "2.0.0-beta11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.8",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17"
  }
}

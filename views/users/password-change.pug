extends ../layouts/main

block content
  .mx-auto.max-w-md.mt-10
    h1.text-2xl.font-bold.mb-4 Change Password
    form(method="post" action="/users/password-change")
      .mb-4
        label.block.mb-1(for="oldPassword") Old Password
        input#oldPassword(type="password" name="oldPassword" required class="w-full border rounded px-3 py-2")
      .mb-4
        label.block.mb-1(for="newPassword") New Password
        input#newPassword(type="password" name="newPassword" required class="w-full border rounded px-3 py-2")
      button(type="submit" class="bg-yellow-600 text-white px-4 py-2 rounded") Change Password

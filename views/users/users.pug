extends layouts/main

block content
  h1.text-3xl.font-bold.mb-6.text-center Users
  .grid.grid-cols-1(class="md:grid-cols-2 lg:grid-cols-3 gap-6")
    each user in users
      .bg-white.shadow-md.rounded-lg.p-6.flex.flex-col.justify-between
        .mb-4
          a.text-xl.font-semibold.text-blue-600(class="hover:underline", href='/users/' + user.id) #{user.name}
        .text-gray-500.text-sm.mb-2
          | Email: #{user.email}
        .text-xs.text-gray-400.mb-2
          | Role: #{user.role}
        .text-xs.text-gray-400.mb-2
          | Active: #{user.active ? 'Yes' : 'No'}
        .text-xs.text-gray-400.mb-2
          | Login Count: #{user.loginCount || 0}

extends ../layouts/main

block content
  .mx-auto.max-w-md.mt-10
    h1.text-2xl.font-bold.mb-4 Register
    form(method="post" action="/auth/register")
      .mb-4
        label.block.mb-1(for="name") Name
        input#name(type="text" name="name" required class="w-full border rounded px-3 py-2")
      .mb-4
        label.block.mb-1(for="email") Email
        input#email(type="email" name="email" required class="w-full border rounded px-3 py-2")
      .mb-4
        label.block.mb-1(for="password") Password
        input#password(type="password" name="password" required class="w-full border rounded px-3 py-2")
      button(type="submit" class="bg-green-600 text-white px-4 py-2 rounded") Register
    p.mt-4
      | Already have an account?
      a.text-blue-600(href="/users/login") Login

extends ../layouts/main

block content
  .max-w-2xl.mx-auto.bg-white.shadow-lg.rounded-lg.p-8.mt-8
    a(href="/posts" class="flex items-center text-blue-600 hover:underline mb-6")
      span.mr-2 &larr;
      |  Back to Posts
    h1.text-3xl.font-bold.mb-2= post.title
    p.text-gray-500.mb-4
      | by #{post.author && post.author.name ? post.author.name : (post.author && post.author.email ? post.author.email : 'Unknown Author')}
    p.text-lg.mb-4= post.content
    if post.publishedAt
      p.text-sm.text-gray-400.mb-6 Published at: #{post.publishedAt.toLocaleString()}
    h2.text-2xl.font-semibold.mt-8.mb-4 Comments
    ul.space-y-4
      if comments.length
        each comment in comments
          li.bg-gray-50.p-4.rounded-md.shadow
            p.mb-1.text-gray-800 #{comment.body}
            span.text-xs.text-gray-500 | by #{comment.author && comment.author.name ? comment.author.name : (comment.author && comment.author.email ? comment.author.email : 'Unknown Author')}
      else
        li.text-gray-400 No comments yet.

extends ../layouts/main

block content
  h1.text-3xl.font-bold.mb-6.text-center Posts
  .grid.grid-cols-1(class="md:grid-cols-2 lg:grid-cols-3 gap-6")
    each post in posts
      .bg-white.shadow-md.rounded-lg.p-6.flex.flex-col.justify-between
        .mb-4
          a.text-xl.font-semibold.text-blue-600(class: "hover:underline", href='/posts/' + post._id) #{post.title}
        .text-gray-500.text-sm.mb-2
          | by #{post.author && post.author.name ? post.author.name : 'Unknown Author'}
        .text-xs.text-gray-400.mb-2
          | Views: #{post.viewCount || 0}
        .text-xs.text-gray-500.mb-2
          | Status: #{post.status}
        .text-xs.text-gray-400.mb-2
          | Tags: #{post.tags && post.tags.length ? post.tags.join(', ') : 'None'}
        .text-xs.text-gray-400.mb-2
          | Slug: #{post.slug}
        .text-xs.text-gray-400.mb-2
          | Published: #{post.publishedAt ? post.publishedAt.toLocaleString() : 'Not published'}
        .text-xs.text-gray-400.mb-2
          | Created: #{post.createdAt ? post.createdAt.toLocaleString() : ''}
        .text-xs.text-gray-400.mb-2
          | Updated: #{post.updatedAt ? post.updatedAt.toLocaleString() : ''}

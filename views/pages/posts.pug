extends ../layouts/main

block content
  h1.text-3xl.font-bold.mb-6.text-center Posts
  .grid.grid-cols-1(class="md:grid-cols-2 lg:grid-cols-3 gap-6")
    each post in posts
      .bg-white.shadow-md.rounded-lg.p-6.flex.flex-col.justify-between
        .mb-4
          a.text-xl.font-semibold.text-blue-600(class: "hover:underline", href=`/posts/${post.id}`) #{post.title}
        .text-gray-500.text-sm.mb-2
          | by #{post.author && post.author.name ? post.author.name : 'Unknown Author'}

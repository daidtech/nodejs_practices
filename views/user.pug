extends layout

block content
  .mx-auto.max-w-2xl
    a(class='mb-4 inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50', href='/users') ← Back to users
    include partials/block
      h1(class='text-2xl font-bold text-slate-900') #{user.name}
      p(class='mt-3 text-slate-600') User ID: #{user.id}
      p(class='mt-2 text-slate-600') Email: #{user.email}
      p(class='mt-2 text-slate-600') Hello #{user.name}
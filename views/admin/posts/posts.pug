extends ../../layouts/admin

block content
  h1(class='text-2xl font-bold text-slate-900 mb-6') Posts
  if posts && posts.length
    each post in posts
      article(class='bg-white p-5 rounded-xl shadow-sm ring-1 ring-slate-200 flex flex-col gap-2 transition hover:shadow-md')
        div(class='flex items-center justify-between')
          h2(class='text-lg font-bold text-indigo-700')= post.title
          span(class='rounded-full px-2.5 py-0.5 text-xs font-medium ' + (post.published ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700'))
            | #{post.published ? 'Published' : 'Draft'}
        if post.content
          p(class='text-sm text-slate-600')= post.content.length > 180 ? post.content.substring(0, 180) + '...' : post.content
        div(class='flex flex-wrap gap-2 text-xs')
          if post.category
            span(class='bg-indigo-50 text-indigo-600 px-2 py-0.5 rounded') #{post.category.description}
          if post.tags && post.tags.length
            each tag in post.tags
              span(class='bg-slate-100 text-slate-600 px-2 py-0.5 rounded') #{tag.name}
        div(class='flex items-center gap-4 text-xs text-slate-400 mt-1')
          if post.author
            span By #{post.author.name}
          span= new Date(post.createdAt).toLocaleDateString()
  else
    p(class='text-slate-500') No posts found.

//- Sidebar partial for admin posts
aside(class="bg-slate-50 p-6 rounded-xl shadow-md flex flex-col gap-4")
  h2(class="text-lg font-bold text-indigo-700 mb-2") Admin Panel
  ul(class="flex flex-col gap-2")
    li
      a(class="text-slate-700 font-medium transition hover:text-indigo-600" href='/admin/posts') All Posts
    li
      a(class="text-slate-700 font-medium transition hover:text-indigo-600" href='/admin/posts?filter=published') Published
    li
      a(class="text-slate-700 font-medium transition hover:text-indigo-600" href='/admin/posts?filter=draft') Drafts
    li
      a(class="text-slate-700 font-medium transition hover:text-indigo-600" href='/admin/posts?filter=archived') Archived
    li(class="mt-4")
      a(class="text-green-700 font-semibold transition hover:text-green-900" href='/admin/posts/new') + New Post

header(class='border-b border-slate-200 bg-white shadow-sm')
  nav(class='mx-auto flex max-w-5xl items-center justify-between px-6 py-3')
    a(class='text-xl font-bold tracking-tight text-slate-900 transition hover:text-indigo-600', href='/') Node.js Practices

    div(class='flex items-center gap-6')
      a(class='text-sm font-medium text-slate-600 transition hover:text-indigo-600', href='/') Home
      a(class='text-sm font-medium text-slate-600 transition hover:text-indigo-600', href='/about') About

      if user
        if user.role === 'admin'
          a(class='text-sm font-medium text-slate-600 transition hover:text-indigo-600', href='/admin/posts') Admin

        div(class='flex items-center gap-3 ml-2 pl-4 border-l border-slate-200')
          a(class='flex items-center gap-2 text-sm font-semibold text-slate-700 transition hover:text-indigo-600', href='/users/profile')
            span(class='flex h-8 w-8 items-center justify-center rounded-full bg-indigo-100 text-xs font-bold text-indigo-600') #{user.name.charAt(0).toUpperCase()}
            span #{user.name}
          a(class='rounded-md bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-red-50 hover:text-red-600', href='/auth/logout') Logout
      else
        div(class='flex items-center gap-2 ml-2 pl-4 border-l border-slate-200')
          a(class='rounded-md bg-slate-100 px-4 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-200', href='/users/login') Login
          a(class='rounded-md bg-indigo-600 px-4 py-1.5 text-sm font-medium text-white transition hover:bg-indigo-700', href='/users/register') Register
